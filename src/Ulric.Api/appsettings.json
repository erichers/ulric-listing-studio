{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ulric": "Data Source=ulric.db"
  },
  "Storage": {
    "Root": "App_Data/uploads"
  },
  "Geocoding": {
    "Enabled": true,
    "UserAgent": "UlricListingStudio/1.0 (+https://github.com/erichers/ulric-listing-studio)",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "MinIntervalMs": 1100
  },
  "Notifier": {
    "Mode": "log"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "PublicBaseUrl": ""
}
