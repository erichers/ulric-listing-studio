# ASP.NET Core reads these names from the environment.
# This file is a reference. It is not loaded automatically.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Sqlite is the zero-config default. Leave Database__Provider as Sqlite
# unless you are pointing at MySQL.
Database__Provider=Sqlite
# AutoDetect reads the server at startup. Set 5.7.39-mysql to skip detection.
Database__ServerVersion=AutoDetect
ConnectionStrings__Ulric=Data Source=ulric.db

# MAMP MySQL 5.7.39 listens on 127.0.0.1 port 8889.
# Create the database with utf8mb4 / utf8mb4_general_ci, then switch the provider.
# These values are examples. Do not commit a real password.
# Database__Provider=MySql
# ConnectionStrings__MySql=Server=127.0.0.1;Port=8889;Database=ulric;User=root;Password=CHANGE_ME;SslMode=None
Storage__Root=App_Data/uploads
Geocoding__Enabled=true
Geocoding__UserAgent=UlricListingStudio/1.0 (+https://github.com/erichers/ulric-listing-studio)
Geocoding__BaseUrl=https://nominatim.openstreetmap.org
Geocoding__MinIntervalMs=1100
Notifier__Mode=log
Cors__Origins__0=http://localhost:4200
# Public origin used for photo, upload, calendar, and Open Graph URLs.
# Leave empty to emit relative paths that follow the page base href.
PublicBaseUrl=
# Set this only when the reverse proxy keeps the prefix on the request it forwards.
# Example: /apps/ulric-listing-studio
PathBase=
